# Valores públicos para el build de producción (Vercel). No son secretos.
# URL pública del sitio (SEO, sitemap, enlaces para compartir eventos)
NEXT_PUBLIC_SITE_URL=https://mambabistrobar.vercel.app
# URL del backend: defínela en Vercel → Settings → Environment Variables cuando Railway te dé el dominio,
# por ejemplo  NEXT_PUBLIC_API_URL=https://<tu-backend>.up.railway.app/api
